{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": false,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 20,
    "showLineNumbers": true
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.env",
      "**/.env.save",
      "**/.env.local",
      "**/.env.production",
      "**/.env.development",
      "**/.env.test",
      "**/.env.*.local",
      "**/.venv/**",
      "**/venv/**",
      "**/node_modules/**",
      "**/.output/**",
      "**/.wrangler/**",
      "**/orquestador_salida/**",
      "**/experimentos/**",
      "**/reports/**",
      "**/.pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/.coverage",
      "**/routeTree.gen.ts",
      "**/*.zip",
      "**/*.pdf",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
